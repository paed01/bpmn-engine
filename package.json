{
  "name": "bpmn-engine",
  "description": "BPMN 2.0 execution engine. Open source javascript workflow engine.",
  "version": "26.0.4",
  "type": "module",
  "module": "./src/index.js",
  "main": "./lib/index.cjs",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.cjs",
      "import": "./src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/paed01/bpmn-engine.git"
  },
  "author": {
    "name": "Pål Edman",
    "url": "https://github.com/paed01"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib/",
    "src/",
    "types/"
  ],
  "scripts": {
    "test": "mocha -p -R @bonniernews/hot-bev",
    "posttest": "npm run lint && npm run toc && npm run dist && npm run test:md",
    "lint": "eslint . --cache && prettier . -c --cache",
    "wintest": "mocha",
    "cov:html": "c8 -r html -r text mocha -p -R @bonniernews/hot-bev",
    "test:lcov": "c8 -r lcov mocha && npm run lint",
    "toc": "node scripts/generate-api-toc ./docs/API.md,./docs/Examples.md",
    "test:md": "texample ./docs/API.md,./docs/Examples.md,./docs/Upgrade.md -c .mocharc.json",
    "dist": "rollup -c",
    "prepack": "npm run dist"
  },
  "keywords": [
    "workflow",
    "engine",
    "process",
    "automation",
    "bpmn",
    "bpmn 2"
  ],
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/paed01/bpmn-engine/master/LICENSE"
    }
  ],
  "overrides": {
    "mocha": {
      "yargs": "^18.0.0"
    }
  },
  "devDependencies": {
    "@bonniernews/hot-bev": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@types/bpmn-moddle": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.40",
    "bent": "^7.3.12",
    "bpmn-elements": "^18.0.15",
    "bpmn-moddle": "^9.0.4",
    "bpmn-moddle-10": "npm:bpmn-moddle@^10.0.0",
    "c8": "^12.0.0",
    "camunda-bpmn-moddle": "^8.0.1",
    "chai": "^6.2.0",
    "chronokinesis": "^8.0.0",
    "debug": "^4.4.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "mocha": "^11.0.1",
    "mocha-cakes-2": "^3.3.0",
    "moddle-context-serializer": "^6.0.0",
    "nock": "^14.0.17",
    "prettier": "^3.2.5",
    "rollup": "^4.10.0",
    "texample": "^1.0.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "bpmn-elements": ">=18",
    "bpmn-moddle": ">=9",
    "debug": ">=4",
    "moddle-context-serializer": ">=6",
    "smqp": ">=13"
  }
}
